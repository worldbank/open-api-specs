    "/data360/portal/v1/dimensions": {
      "post": {
        "tags": [
          "Other"
        ],
        "summary": "Disaggregations for a given indicator",
        "description": "Returns all possible disaggregations for a specific indicator.",
        "operationId": "getDimensions",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DimensionDataDetails"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DimensionDataDetails"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DimensionDataDetails"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/data360/portal/v1/hierarchy": {
      "get": {
        "tags": [
          "Other"
        ],
        "summary": "Retrieve hierarchy",
        "operationId": "getHierarchy",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "site",
            "in": "query",
            "schema": {
              "type": "string",
              "default": ""
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/data360/portal/v1/metadata": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "Retrieve dataset or indicator metadata",
        "description": "Returns the metadata JSON document for a dataset or an indicator.\n\n- For dataset metadata, set `type` to `dataset` and `id` to the dataset identifier.\n- For indicator metadata, set `type` to `indicator`, `id` to the identifier of the parent entity, and `subtype_id` to the indicator identifier.",
        "operationId": "getMetadata",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Metadata type: 'dataset' or 'indicator'.",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "dataset",
                "indicator"
              ]
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "Dataset or parent entity identifier.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subtype_id",
            "in": "query",
            "description": "Indicator identifier. Required when `type` is `indicator`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/data360/portal/v1/get_entities_by_id": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Retrieves entities by their ID with specified fields.",
        "operationId": "getEntitiesById",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByIdRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByIdRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByIdRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/data360/portal/v1/entities_by_economy_topic_tag": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Retrieve entities by economy, topic, and tags with pagination.",
        "operationId": "getEntitiesByEconomyTopicTag",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByCountryTopicTagRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByCountryTopicTagRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByCountryTopicTagRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/VectorSearchWithoutFacetsResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VectorSearchWithoutFacetsResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/VectorSearchWithoutFacetsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "databaseIdQuery": {
        "name": "DATABASE_ID",
        "in": "query",
        "description": "Unique identifier for the database.",
        "required": true,
        "schema": {
          "type": "string"
        },
        "example": "WB_WDI"
      },
      "indicatorQuery": {
        "name": "INDICATOR",
        "in": "query",
        "description": "Indicator ID.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": "WB_WDI_SP_POP_TOTL"
      },
      "refAreaQuery": {
        "name": "REF_AREA",
        "in": "query",
        "description": "Reference area code (e.g., country code).",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "sexQuery": {
        "name": "SEX",
        "in": "query",
        "description": "Sex of the subjects, if applicable.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "ageQuery": {
        "name": "AGE",
        "in": "query",
        "description": "Age group filter.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "urbanisationQuery": {
        "name": "URBANISATION",
        "in": "query",
        "description": "Urbanisation filter.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "compBreakdown1Query": {
        "name": "COMP_BREAKDOWN_1",
        "in": "query",
        "description": "Indicator specific dimension.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "compBreakdown2Query": {
        "name": "COMP_BREAKDOWN_2",
        "in": "query",
        "description": "Indicator specific dimensionn.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "compBreakdown3Query": {
        "name": "COMP_BREAKDOWN_3",
        "in": "query",
        "description": "Indicator specific dimensionn.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
