    "/data360/portal/v1/data": {
      "get": {
        "tags": [
          "Data"
        ],
        "summary": "Data based on provided filters",
        "description": "Retrieves dataset or indicators data based on a range of query filters.",
        "operationId": "getPortalData",
        "parameters": [
          {
            "name": "database_id",
            "in": "query",
            "description": "Unique identifier for the database.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "indicator_id",
            "in": "query",
            "description": "Indicator ID.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timePeriodFrom",
            "in": "query",
            "description": "Start of the time period range.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "timePeriodTo",
            "in": "query",
            "description": "End of the time period range.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "isLatestData",
            "in": "query",
            "description": "Flag indicating whether to retrieve the latest data.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "filters",
            "in": "query",
            "schema": {
              "type": "string",
              "default": ""
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success. Returns the indicators data of records matching the query.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalDataResponse"
                },
                "examples": {
                  "sample": {
