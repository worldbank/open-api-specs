    "/data/int/v3/data360/codelist": {
  "get": {
    "operationId": "getData360Codelist",
    "summary": "Retrieve codelist metadata and codes",
    "description": "Returns codelist metadata and items matching the given filters and options.",
    "security": [
      { "SubscriptionKey": [] },
      { "BearerAuth": [] }
    ],
    "parameters": [
      {
        "name": "name",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "default": "AGE" },
        "description": "Codelist identifier (e.g., AGE)."
      },
      {
        "name": "group",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "default": "DIGITAL" },
        "description": "Codelist group/agency context (e.g., DIGITAL)."
      },
      {
        "name": "search",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "default": "" },
        "description": "Free-text search over codelist fields."
      },
      {
        "name": "searchFields",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "default": "" },
        "description": "Comma-separated list of fields to search (e.g., 'id,names.value')."
      },
      {
        "name": "filter",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "default": "" },
        "description": "Filter expression to limit results."
      },
      {
        "name": "orderby",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "default": "" },
        "description": "Sort expression (e.g., 'id asc')."
      },
      {
        "name": "select",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "default": "" },
        "description": "Comma-separated list of fields to include."
      },
      {
        "name": "top",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "default": 1000 },
        "description": "Maximum number of records to return."
      },
      {
        "name": "skip",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 0, "default": 0 },
        "description": "Number of records to skip (offset for pagination)."
      },
      {
        "name": "count",
        "in": "query",
        "required": false,
        "schema": { "type": "boolean", "default": false },
        "description": "If true, include a total count."
      },
      {
        "name": "facets",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "default": "" },
        "description": "Comma-separated facet fields to aggregate on."
      }
    ],
    "responses": {
      "200": {
        "description": "Successful response with codelist metadata and items.",
        "content": {
          "application/json": {
            "examples": {
              "sample": {
                "summary": "Sample response",
