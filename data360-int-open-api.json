"/data/int/v3/data360/getuseraction": {
  "get": {
    "operationId": "getUserAction",
    "summary": "Get user action statistics",
    "description": "Returns usage statistics (e.g., view/download counts) for the specified indicator and dataset.",
    "security": [
      { "SubscriptionKey": [] },
      { "BearerAuth": [] }
    ],
    "parameters": [
      {
        "name": "indicator",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "default": "WB_WDI_BX_KLT_DINV_WD_GD_ZS"
        },
        "description": "Indicator identifier."
      },
      {
        "name": "datasetId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "default": "WB_WDI"
        },
        "description": "Dataset identifier."
      },
      {
        "name": "Type",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "default": "Indicator"
        },
        "description": "Type of entity the action applies to."
      }
    ],
    "responses": {
      "200": {
        "description": "Successful response with user action counts.",
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ViewCount": {
                    "type": "integer",
                    "description": "Number of times the indicator was viewed.",
                    "example": 10
                  },
                  "DownloadCount": {
                    "type": "integer",
                    "description": "Number of times the indicator was downloaded.",
                    "example": 0
                  }
                },
                "required": ["ViewCount", "DownloadCount"]
              }
            },
            "example": [
              {
                "ViewCount": 10,
                "DownloadCount": 0
              }
            ]
          }
        }
      },
      "400": {
        "description": "Invalid request parameters."
      },
      "401": {
        "description": "Unauthorized – missing or invalid authentication headers."
      },
      "500": {
        "description": "Server error while retrieving user actions."
      }
    },
    "tags": ["Other"]
  }
},
"/data/int/v3/data360/saveuseraction": {
  "post": {
    "operationId": "saveUserAction",
    "summary": "Save a user action",
    "description": "Records a user action (e.g., viewing an indicator) for analytics or tracking purposes.",
    "security": [
      { "SubscriptionKey": [] },
      { "BearerAuth": [] }
    ],
    "requestBody": {
      "required": true,
