              }
            },
            "required": ["indicator", "action", "datasetId", "type"]
          },
          "example": {
            "indicator": "WB_WDI_BX_KLT_DINV_WD_GD_ZS",
            "action": "View",
            "datasetId": "WB_WDI",
            "type": "Indicator"
          }
        }
      }
    },
    "responses": {
