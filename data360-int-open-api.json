{
  "openapi": "3.0.3",
  "info": {
    "title": "Data360 API",
    "version": "1.0.0",
    "description": "Documentation for the internal Data360 API.\n\nAuthentication requires BOTH:\n1) An API subscription key via the `Ocp-Apim-Subscription-Key` header\n2) A Bearer token via the `Authorization` header"
  },
  "servers": [
    {
      "url": "https://datacatalogapiqa.worldbank.org"
    }
  ],
  "paths": {
    "/data/int/v3/data360/search": {
  "post": {
    "operationId": "searchData360",
    "summary": "Search for indicators and datasets",
    "description": "Performs a full-text search across available series descriptions, filtered and ordered by user-specified criteria.",
    "security": [
      { "SubscriptionKey": [] },
      { "BearerAuth": [] }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "count": {
                "type": "boolean",
                "description": "Whether to return a total count of matching results.",
                "default": true
              },
              "filter": {
                "type": "string",
                "description": "OData filter expression.",
                "example": "series_description/topics/any(t: t/name eq 'Health') and type eq 'indicator'"
              },
              "orderby": {
                "type": "string",
                "description": "Ordering of the results.",
                "example": "series_description/name"
              },
              "select": {
                "type": "string",
                "description": "Comma-separated list of fields to return.",
                "example": "series_description/idno, series_description/name, series_description/database_id"
              },
              "search": {
                "type": "string",
                "description": "Search text to match against documents.",
                "example": "nutrition"
              },
              "top": {
                "type": "integer",
                "description": "Maximum number of results to return.",
                "default": 20
              },
              "skip": {
                "type": "integer",
                "description": "Number of results to skip (for paging).",
                "default": 0
              },
              "searchFields": {
                "type": "string",
                "description": "Fields to restrict the search to.",
                "default": ""
              },
              "facets": {
                "type": "array",
                "description": "List of facet expressions.",
                "items": { "type": "string" },
                "default": []
              }
            },
            "required": ["search"]
          },
          "example": {
            "count": true,
            "filter": "series_description/topics/any(t: t/name eq 'Health') and type eq 'indicator'",
            "orderby": "series_description/name",
            "select": "series_description/idno, series_description/name, series_description/database_id",
            "search": "nutrition",
            "top": 20,
            "skip": 0,
            "searchFields": "",
            "facets": []
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Successful search response with matching indicators.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "@odata.count": {
                  "type": "integer",
                  "description": "Total number of matching records when count=true."
                },
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "@search.score": {
                        "type": "number",
                        "format": "float",
                        "description": "Search relevance score."
                      },
                      "series_description": {
                        "type": "object",
                        "properties": {
                          "idno": {
                            "type": "string",
                            "description": "Series identifier."
                          },
                          "name": {
                            "type": "string",
                            "description": "Human-readable name of the series."
                          },
                          "database_id": {
                            "type": "string",
                            "description": "Database identifier the series belongs to."
                          }
                        },
                        "required": ["idno", "name", "database_id"]
                      }
                    },
                    "required": ["@search.score", "series_description"]
                  }
                }
              },
              "required": ["value"]
            },
            "example": {
              "@odata.count": 10,
              "value": [
                {
                  "@search.score": 6.868912,
                  "series_description": {
                    "idno": "WB_GS_SH_DTH_ZS",
                    "name": "Cause of death (%)",
                    "database_id": "WB_GS"
                  }
                },
                {
                  "@search.score": 9.307275,
                  "series_description": {
                    "idno": "WB_WDI_SH_STA_STNT_FE_ZS",
                    "name": "Prevalence of stunting, height for age, female (% of children under 5)",
                    "database_id": "WB_WDI"
                  }
                }
              ]
            }
          }
        }
      },
      "400": {
        "description": "Invalid request body or query."
      },
      "401": {
        "description": "Unauthorized – missing or invalid authentication headers."
      },
      "500": {
        "description": "Server error while performing search."
      }
    },
    "tags": ["Search"]
  }
},
    "/data/int/v3/data360/data": {
      "get": {
        "operationId": "getData360",
        "summary": "Query Data360 observations",
        "description": "Returns observations matching the given filters and options.",
        "security": [
          { "SubscriptionKey": [] },
          { "BearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "DATABASE_ID",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "default": "WB_WDI"},
            "description": "Database identifier"
          },
          {
            "name": "INDICATOR",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "default": "WB_WDI_BX_KLT_DINV_WD_GD_ZS" },
            "description": "Indicator code"
          },
          {
            "name": "REF_AREA",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "ETH" },
            "description": "Reference area (ISO3 code like ETH)."
          },
          {
            "name": "SEX",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "_T" },
            "description": "Sex breakdown; use _T for total."
          },
          {
            "name": "AGE",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "_T" },
            "description": "Age breakdown; use _T for total."
          },
          {
            "name": "URBANISATION",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "_T" },
            "description": "Urbanisation breakdown; use _T for total."
          },
          {
            "name": "COMP_BREAKDOWN_1",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "_Z" },
            "description": "First complementary breakdown; use _Z for not applicable."
          },
          {
            "name": "COMP_BREAKDOWN_2",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "_Z" },
            "description": "Second complementary breakdown; use _Z for not applicable."
          },
          {
            "name": "COMP_BREAKDOWN_3",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "_Z" },
            "description": "Third complementary breakdown; use _Z for not applicable."
          },
          {
            "name": "TIME_PERIOD",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Single time period (e.g., '2010'). If not provided, use timePeriodFrom/timePeriodTo."
          },
          {
            "name": "timePeriodFrom",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" },
            "description": "Start year for time range (inclusive)."
          },
          {
            "name": "timePeriodTo",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" },
            "description": "End year for time range (inclusive)."
          },
          {
            "name": "FREQ",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["A", "Q", "M"], "default": "A" },
            "description": "Frequency: A=Annual, Q=Quarterly, M=Monthly."
          },
          {
            "name": "UNIT_MEASURE",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Unit of measure (e.g., PT_GDP)."
          },
          {
            "name": "UNIT_MULT",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" },
            "description": "Unit multiplier (e.g., 0)."
          },
          {
            "name": "top",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1 },
            "description": "Maximum number of records to return."
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 0, "default": 0 },
            "description": "Number of records to skip (offset for pagination)."
          },
          {
            "name": "isLatestData",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": false },
            "description": "If true, only return latest available data per series."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with observations.",
            "content": {
              "application/json": {
                "examples": {
                  "sample": {
                    "summary": "Sample response",
                    "value": {
                      "count": 1,
                      "value": [
                        {
                          "OBS_VALUE": "0.963031",
                          "TIME_FORMAT": "P1Y",
                          "UNIT_MULT": 0,
                          "COMMENT_OBS": null,
                          "OBS_STATUS": "A",
                          "OBS_CONF": "PU",
                          "AGG_METHOD": "_Z",
                          "DECIMALS": "2",
                          "COMMENT_TS": "Foreign direct investment, net inflows (% of GDP)",
                          "DATA_SOURCE": "WB_WDI",
                          "LATEST_DATA": false,
                          "DATABASE_ID": "WB_WDI",
                          "INDICATOR": "WB_WDI_BX_KLT_DINV_WD_GD_ZS",
                          "REF_AREA": "ETH",
                          "SEX": "_T",
                          "AGE": "_T",
                          "URBANISATION": "_T",
                          "COMP_BREAKDOWN_1": "_Z",
                          "COMP_BREAKDOWN_2": "_Z",
                          "COMP_BREAKDOWN_3": "_Z",
                          "TIME_PERIOD": "2010",
                          "FREQ": "A",
                          "UNIT_MEASURE": "PT_GDP",
                          "UNIT_TYPE": null
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tags": ["Data"]
      }
    },
