                          "COMMENT_OBS": null,
                          "OBS_STATUS": "A",
                          "OBS_CONF": "PU",
                          "AGG_METHOD": "_Z",
                          "DECIMALS": "2",
                          "COMMENT_TS": null,
                          "DATA_SOURCE": null,
                          "LATEST_DATA": false,
                          "SEGMENT": null,
                          "EV_CRITERIA": null,
                          "DATABASE_ID": "WB_WDI",
                          "INDICATOR": "WB_WDI_SP_POP_TOTL",
                          "REF_AREA": "AGO",
                          "SEX": "_T",
                          "AGE": "_T",
                          "URBANISATION": "_T",
                          "COMP_BREAKDOWN_1": "_Z",
                          "COMP_BREAKDOWN_2": "_Z",
                          "COMP_BREAKDOWN_3": "_Z",
