              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/data360/portal/v1/data": {
      "get": {
        "tags": [
          "Data"
        ],
        "summary": "Data based on provided filters",
        "description": "Retrieves dataset or indicators data based on a range of query filters.",
        "operationId": "getPortalData",
        "parameters": [
          {
            "name": "database_id",
            "in": "query",
            "description": "Unique identifier for the database.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "indicator_id",
            "in": "query",
            "description": "Indicator ID.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timePeriodFrom",
            "in": "query",
            "description": "Start of the time period range.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "timePeriodTo",
            "in": "query",
            "description": "End of the time period range.",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "isLatestData",
            "in": "query",
            "description": "Flag indicating whether to retrieve the latest data.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "filters",
            "in": "query",
            "schema": {
              "type": "string",
              "default": ""
            },
            "description": "Additional dimension filters, as a URL-encoded JSON array of `Filter` objects, for example `[{\"filterColumn\":\"REF_AREA\",\"filterValue\":\"AGO\"}]`."
          }
        ],
        "responses": {
          "200": {
            "description": "Success. Returns the indicators data of records matching the query.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalDataResponse"
                },
                "examples": {
                  "latest": {
                    "summary": "Latest total population of Angola",
                    "description": "Response to `GET /data360/portal/v1/data?database_id=WB_WDI&indicator_id=WB_WDI_SP_POP_TOTL&isLatestData=true&filters=[{\"filterColumn\":\"REF_AREA\",\"filterValue\":\"AGO\"}]` (with `filters` URL-encoded).",
                    "value": [
                      {
                        "AGE": "_T",
                        "AGG_METHOD": "_Z",
                        "COMP_BREAKDOWN_1": "_Z",
                        "COMP_BREAKDOWN_2": "_Z",
                        "COMP_BREAKDOWN_3": "_Z",
                        "DATABASE_ID": "WB_WDI",
                        "DECIMALS": "2",
                        "FREQ": "A",
                        "INDICATOR": "WB_WDI_SP_POP_TOTL",
                        "OBS_CONF": "PU",
                        "OBS_STATUS": "A",
                        "REF_AREA": "AGO",
                        "SEX": "_T",
                        "UNIT_MEASURE": "PS",
                        "UNIT_MULT": 0,
                        "UNIT_TYPE": null,
                        "URBANISATION": "_T",
                        "range": "latest",
                        "data": {
                          "xAxis": [
                            "2025"
                          ],
                          "yAxis": [
                            "39040039"
                          ]
                        }
                      }
                    ]
                  },
                  "timeRange": {
                    "summary": "Total population of Angola, 2020-2024",
                    "description": "Response to `GET /data360/portal/v1/data?database_id=WB_WDI&indicator_id=WB_WDI_SP_POP_TOTL&isLatestData=false&timePeriodFrom=2020&timePeriodTo=2024&filters=[{\"filterColumn\":\"REF_AREA\",\"filterValue\":\"AGO\"}]` (with `filters` URL-encoded).",
                    "value": [
                      {
                        "AGE": "_T",
                        "AGG_METHOD": "_Z",
                        "COMP_BREAKDOWN_1": "_Z",
                        "COMP_BREAKDOWN_2": "_Z",
                        "COMP_BREAKDOWN_3": "_Z",
                        "DATABASE_ID": "WB_WDI",
                        "DECIMALS": "2",
                        "FREQ": "A",
                        "INDICATOR": "WB_WDI_SP_POP_TOTL",
                        "OBS_CONF": "PU",
                        "OBS_STATUS": "A",
                        "REF_AREA": "AGO",
                        "SEX": "_T",
                        "UNIT_MEASURE": "PS",
                        "UNIT_MULT": 0,
                        "UNIT_TYPE": null,
                        "URBANISATION": "_T",
                        "range": "2020 - 2024",
                        "data": {
                          "xAxis": [
                            "2020",
                            "2021",
                            "2022",
                            "2023",
                            "2024"
                          ],
                          "yAxis": [
                            "33451132",
                            "34532429",
                            "35635029",
                            "36749906",
                            "37885849"
                          ]
                        }
                      }
                    ]
                  }
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/data360/portal/v1/temporaldata": {
      "post": {
        "tags": [
          "Data"
        ],
        "summary": "Retrieve indicators time series data",
        "description": "Retrieves indicators time series data based on a range of query filters.",
        "operationId": "getTemporalData",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemporalDataRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/TemporalDataRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/TemporalDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success. Returns the indicators time series data of records matching the query.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemporalDataResponse"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/data360/portal/v1/dimensions": {
      "post": {
        "tags": [
          "Other"
        ],
        "summary": "Disaggregations for a given indicator",
        "description": "Returns all possible disaggregations for a specific indicator.",
        "operationId": "getDimensions",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DimensionDataDetails"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DimensionDataDetails"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DimensionDataDetails"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/data360/portal/v1/hierarchy": {
      "get": {
        "tags": [
          "Other"
        ],
        "summary": "Retrieve hierarchy",
        "operationId": "getHierarchy",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "site",
            "in": "query",
            "schema": {
              "type": "string",
              "default": ""
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/data360/portal/v1/metadata": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "Retrieve dataset or indicator metadata",
        "description": "Returns the metadata JSON document for a dataset or an indicator.\n\n- For dataset metadata, set `type` to `dataset` and `id` to the dataset identifier.\n- For indicator metadata, set `type` to `indicator`, `id` to the identifier of the parent entity, and `subtype_id` to the indicator identifier.",
        "operationId": "getMetadata",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Metadata type: 'dataset' or 'indicator'.",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "dataset",
                "indicator"
              ]
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "Dataset or parent entity identifier.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subtype_id",
            "in": "query",
            "description": "Indicator identifier. Required when `type` is `indicator`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/data360/portal/v1/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Search Data360",
        "operationId": "searchData360",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VectorSearchV2Request"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/VectorSearchV2Request"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/VectorSearchV2Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/VectorSearchResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VectorSearchResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/VectorSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/data360/portal/v1/get_entities_by_id": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Retrieves entities by their ID with specified fields.",
        "operationId": "getEntitiesById",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByIdRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByIdRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByIdRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/data360/portal/v1/entities_by_economy_topic_tag": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Retrieve entities by economy, topic, and tags with pagination.",
        "operationId": "getEntitiesByEconomyTopicTag",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByCountryTopicTagRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByCountryTopicTagRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/GetEntitiesByCountryTopicTagRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/VectorSearchWithoutFacetsResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VectorSearchWithoutFacetsResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/VectorSearchWithoutFacetsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "databaseIdQuery": {
        "name": "DATABASE_ID",
        "in": "query",
        "description": "Unique identifier for the database.",
        "required": true,
        "schema": {
          "type": "string"
        },
        "example": "WB_WDI"
      },
      "indicatorQuery": {
        "name": "INDICATOR",
        "in": "query",
        "description": "Indicator ID.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": "WB_WDI_SP_POP_TOTL"
      },
      "refAreaQuery": {
        "name": "REF_AREA",
        "in": "query",
        "description": "Reference area code (e.g., country code).",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "sexQuery": {
        "name": "SEX",
        "in": "query",
        "description": "Sex of the subjects, if applicable.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "ageQuery": {
        "name": "AGE",
        "in": "query",
        "description": "Age group filter.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "urbanisationQuery": {
        "name": "URBANISATION",
        "in": "query",
        "description": "Urbanisation filter.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "compBreakdown1Query": {
        "name": "COMP_BREAKDOWN_1",
        "in": "query",
        "description": "Indicator specific dimension.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "compBreakdown2Query": {
        "name": "COMP_BREAKDOWN_2",
        "in": "query",
        "description": "Indicator specific dimension.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "compBreakdown3Query": {
        "name": "COMP_BREAKDOWN_3",
        "in": "query",
        "description": "Indicator specific dimension.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "timePeriodQuery": {
        "name": "TIME_PERIOD",
        "in": "query",
        "description": "Time period for the data.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "freqQuery": {
        "name": "FREQ",
        "in": "query",
        "description": "Frequency of the data.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "unitMeasureQuery": {
        "name": "UNIT_MEASURE",
        "in": "query",
        "description": "Unit of measure for the data.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "unitTypeQuery": {
        "name": "UNIT_TYPE",
        "in": "query",
        "description": "Type of unit (e.g., 'currency', 'percentage').",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "unitMultQuery": {
        "name": "UNIT_MULT",
        "in": "query",
        "description": "Multiplier for the unit.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "timePeriodFromQuery": {
        "name": "timePeriodFrom",
        "in": "query",
        "description": "Start of the time period range.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "timePeriodToQuery": {
        "name": "timePeriodTo",
        "in": "query",
        "description": "End of the time period range.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "skipQuery": {
        "name": "skip",
        "in": "query",
        "description": "Number of records to skip. Each API call returns a maximum of 1000 records. Use the skip parameter to paginate through the results.",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        "example": 0
      },
      "evCriteriaQuery": {
        "name": "EV_CRITERIA",
        "in": "query",
        "description": "Evaluation criteria filter. WDI data has no evaluation criteria dimension: this field is `null` in WDI records.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "segmentQuery": {
        "name": "SEGMENT",
        "in": "query",
        "description": "Segment filter. WDI data has no segment dimension: this field is `null` in WDI records.",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      },
      "aggregationmethodQuery": {
        "name": "AGG_METHOD",
        "in": "query",
        "description": "Aggregation method filter (e.g. `_Z` for not applicable).",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": ""
      }
    },
    "schemas": {
      "DataResponse": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "description": "Total number of matching records."
          },
          "value": {
            "type": "array",
            "description": "Array of data records.",
            "items": {
              "type": "object",
              "properties": {
                "OBS_VALUE": {
                  "type": "string",
                  "description": "Observation value."
                },
                "TIME_FORMAT": {
                  "type": "string",
                  "description": "Time format, e.g., period (P1Y)."
                },
                "UNIT_MULT": {
                  "type": "integer",
                  "description": "Multiplier for the unit."
                },
                "COMMENT_OBS": {
